{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 -B \"$CLAUDE_PROJECT_DIR/tests/knowledge_guard.py\" --start",
            "timeout": 30,
            "statusMessage": "지식 세 층 검사"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 -B \"$CLAUDE_PROJECT_DIR/tests/knowledge_guard.py\" --stop",
            "timeout": 30,
            "statusMessage": "지식 층 갱신 확인"
          }
        ]
      }
    ]
  }
}
